    TargetingStrategy <|-- AmbushTargeting
    TargetingStrategy <|-- WhimsicalTargeting
    TargetingStrategy <|-- PokeyTargeting
    World *-- CoachMan : coachman
    World *-- Ghost : ghosts [4]
    World ..> EntityFactory : usa
    World ..|> GhostWorld
